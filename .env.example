# Copy this file to ".env" and fill in your own values. Never commit ".env".
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_actual_postgres_password
DB_NAME=mealdeal
PORT=3000

# Hosted (for example Render): set DATABASE_URL instead of the DB_* values.
# DATABASE_URL=postgresql://user:password@host:5432/mealdeal
